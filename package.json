{
  "name": "empirica-networks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Network experiments for Empirica: neighbor-limited visibility, topologies, and rewiring.",
  "license": "MIT",
  "author": "Eric Martin Feltham <eric.feltham@aya.yale.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emfeltham/empirica-networks.git"
  },
  "homepage": "https://github.com/emfeltham/empirica-networks#readme",
  "bugs": {
    "url": "https://github.com/emfeltham/empirica-networks/issues"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./package.json": "./package.json",
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./admin/monitor": {
      "types": "./dist/admin/monitor/index.d.ts",
      "import": "./dist/admin/monitor/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    },
    "./bots": {
      "types": "./dist/bots/index.d.cts",
      "default": "./dist/bots/index.cjs"
    },
    "./player/react": {
      "types": "./dist/player/react/index.d.ts",
      "import": "./dist/player/react/index.js"
    },
    "./topology": {
      "types": "./dist/topology/index.d.ts",
      "import": "./dist/topology/index.js"
    },
    "./topology/graphology": {
      "types": "./dist/topology/graphology.d.ts",
      "import": "./dist/topology/graphology.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup",
    "check": "tsc --noEmit",
    "check:links": "node scripts/checks/check-links.mjs",
    "check:docs": "node scripts/checks/check-docs-api.mjs",
    "test": "node scripts/test.mjs",
    "test:one": "node scripts/e2e-one.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "example:install": "node scripts/example-install.mjs",
    "bench": "node scripts/bench.mjs",
    "simulate": "node scripts/simulate.mjs",
    "soak": "node scripts/soak.mjs",
    "test:repeat": "node scripts/e2e-repeat.mjs",
    "example:build": "node scripts/example-build.mjs",
    "figure:shot": "node scripts/figure-shot.mjs"
  },
  "peerDependencies": {
    "@empirica/core": ">=1.12.0 <2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "rxjs": "^7.5.5"
  },
  "devDependencies": {
    "@empirica/core": "1.12.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild": "^0.21.0",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "empirica-networks": "./dist/verify/cli.cjs"
  }
}
