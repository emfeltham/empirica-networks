{
  "name": "empirica-networks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Network experiments for Empirica: neighbour-limited visibility, topologies, and rewiring.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    },
    "./player/react": {
      "types": "./dist/player/react/index.d.ts",
      "import": "./dist/player/react/index.js"
    },
    "./topology": {
      "types": "./dist/topology/index.d.ts",
      "import": "./dist/topology/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "example:install": "npm run build && npm pack --pack-destination . && rm -rf examples/minimal/server/node_modules/empirica-networks examples/minimal/client/node_modules/empirica-networks examples/minimal/server/package-lock.json examples/minimal/client/package-lock.json examples/minimal/client/node_modules/.vite && npm --prefix examples/minimal/server install && npm --prefix examples/minimal/client install",
    "bench": "node scripts/bench.mjs"
  },
  "peerDependencies": {
    "@empirica/core": ">=1.12.0 <2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "rxjs": "^7.5.5"
  },
  "devDependencies": {
    "@empirica/core": "1.12.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild": "^0.21.0",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "empirica-networks": "./dist/verify/cli.cjs"
  }
}
